# Local-only dev file (gitignored) used to exercise Phase 3 against the
# Firebase LOCAL EMULATOR SUITE, not a real project. "demo-" project ids are
# a Firebase convention for emulator-only use and need no real GCP project.
EXPO_PUBLIC_FIREBASE_API_KEY=demo-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-bhoomishakti.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-bhoomishakti
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-bhoomishakti.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

EXPO_PUBLIC_USE_FIREBASE_EMULATOR=1
